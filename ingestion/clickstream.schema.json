{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:albert-marketplace:clickstream:v1",
  "title": "Albert's Marketplace clickstream v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "event_time", "emitted_at", "buyer_id", "session_id"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["product_viewed", "added_to_cart", "order_placed"]},
    "event_time": {"type": "string", "format": "date-time"},
    "emitted_at": {"type": "string", "format": "date-time"},
    "buyer_id": {"type": "string", "minLength": 1, "maxLength": 40},
    "session_id": {"type": "string", "format": "uuid"},
    "p_id": {"type": "string", "minLength": 1, "maxLength": 10},
    "price": {"type": "number", "minimum": 0},
    "qty": {"type": "integer", "minimum": 1},
    "order_id": {"type": "integer", "minimum": 1},
    "payment_method": {"enum": ["Credit Card", "PayPal", "Bank Transfer"]},
    "amount": {"type": "number", "minimum": 0},
    "currency": {"const": "EUR"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["p_id", "qty", "price"],
        "properties": {
          "p_id": {"type": "string", "minLength": 1, "maxLength": 10},
          "qty": {"type": "integer", "minimum": 1},
          "price": {"type": "number", "minimum": 0}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "product_viewed"}}}, "then": {"required": ["p_id", "price"]}},
    {"if": {"properties": {"event_type": {"const": "added_to_cart"}}}, "then": {"required": ["p_id", "qty", "price"]}},
    {"if": {"properties": {"event_type": {"const": "order_placed"}}}, "then": {"required": ["order_id", "payment_method", "amount", "currency", "items"]}}
  ]
}
