# Copy this file to .env (which is never committed) and fill it in.
# Values arrive with the lessons that need them.

# Google Cloud: nonsecret identifiers; authenticate separately with your own ADC.
GCP_PROJECT_ID=data-engineering-i1
GCP_REGION=europe-west1
BRONZE_BUCKET=data-engineering-i1-marketplace-group

# Step 3 SQL extractor. Fill the password only in your ignored local .env.
# These localhost settings target the Docker operator's machine. A remote host
# needs an approved encrypted connection; never expose the default source DB.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=marketplace
PGUSER=marketplace_ingest
PGPASSWORD=
PGSSLMODE=disable
SOURCE_ID=marketplace-group-v1

# Step 3 Kafka: local Docker or an approved tunnel. For a direct remote broker,
# use the operator's TLS/SASL settings instead of plaintext.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=clickstream
KAFKA_GROUP_ID=marketplace-bronze-v1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CAFILE=
